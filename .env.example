# OpenAI API key (server only — never VITE_* prefix)
OPENAI_API_KEY=

# Optional: defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional: Text-to-speech (POST /api/speech → OpenAI audio/speech)
# OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# OPENAI_SPEECH_VOICE=coral

# Optional: API server port (must match Vite proxy target)
# API_PORT=8787

# Optional: override Vite dev proxy target (default http://127.0.0.1:8787)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
